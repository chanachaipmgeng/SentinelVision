      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dpu-prometheus"
          },
          "expr": "sum(rate(dpu_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(dpu_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx",
          "refId": "A"
