# Copy to .env and adjust as needed:
#   cp .env.example .env

POSTGRES_USER=dpu
POSTGRES_PASSWORD=dpu_secret
POSTGRES_DB=dpu
# Standalone: 5432. Side-by-side with face-core on same host (face-core uses 5435): 5434
POSTGRES_PORT=5434

# Public HTTP entry (nginx gateway). Standalone: 80. BFF dev alongside face-core :8081: 8880
HTTP_PORT=8880

# Cosine distance for InsightFace (lower = stricter). Typical match < 0.40
FACE_RECOGNITION_THRESHOLD=0.40

# Single-Frame Passive Anti-Spoofing (YCrCb chrominance variance + screen glare rejection)
FACE_ANTISPOOF_ENABLED=true
FACE_ANTISPOOF_MIN_CHROMA_STD=2.0
FACE_ANTISPOOF_MAX_SPECULAR_RATIO=0.22

# Face check-in soft dedupe window (seconds). Same employee within this window = no new timestamp. 0 = off.
CHECK_IN_DEDUPE_SECONDS=300

IMAGE_BLUR_THRESHOLD=20.0
# Excel import of photos from other HR systems. 0 = do not reject blurry faces (a face must still be detected).
IMAGE_BLUR_THRESHOLD_IMPORT=0
IMAGE_BRIGHTNESS_MIN=40
IMAGE_BRIGHTNESS_MAX=220

# Web-Manage (admin SPA) runtime config — injected into assets/config.json at container start.
# Restrict the key to your domains (HTTP referrer) in Google Cloud Console. Empty = Google Maps off, OSM fallback.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Must be a random string of at least 32 characters. Startup refuses the placeholder when AUTH_FAIL_FAST=true.
SECRET_KEY=replace-with-a-random-string-at-least-32-chars
AUTH_FAIL_FAST=true
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Kiosk device token (short, refreshed via /auth/kiosk/refresh) and its refresh token lifetime.
KIOSK_TOKEN_EXPIRE_HOURS=12
KIOSK_REFRESH_EXPIRE_DAYS=30
# One-time pairing code validity (minutes) and per-IP attempts/minute at /auth/kiosk/pair.
KIOSK_PAIRING_CODE_TTL_MINUTES=10
KIOSK_PAIR_MAX_ATTEMPTS_PER_MINUTE=10
# Deprecated: accept `?token=` in URLs (leaks into access logs). Leave off.
AUTH_ALLOW_QUERY_TOKEN=false
# Revocation negative-cache TTL (s) — how fast a logout/revoke reaches other API replicas.
AUTH_REVOCATION_CACHE_SECONDS=30
OIDC_ISSUER=
OIDC_CLIENT_ID=
EXPOSE_API_DOCS=false

# InsightFace devices, comma-separated. One worker is bound to each device.
# Single GPU:
FACE_DEVICE=cuda:0
FACE_DEVICES=cuda:0
FACE_GPU_WORKERS=1
# Dual GPU (after nvidia-smi shows two cards) — recreate api:
# FACE_DEVICES=cuda:0,cuda:1
# FACE_GPU_WORKERS=2
# Optional: try FACE_GPU_WORKERS=2 on one card only if nvidia-smi util stays <60% under load.
FACE_DETECT_DET_SIZE=320
FACE_EMBED_DET_SIZE=640
WS_DETECT_MIN_INTERVAL_MS=80
WS_QUEUE_BACKPRESSURE=32
FACE_DETECT_STALE_MS=400
FACE_IDENTIFY_CACHE_SECONDS=3.0

# Face Core microservice (BFF mode — vision delegated to face-core hub)
FACE_CORE_ENABLED=false
# Docker BFF (face-net): http://face-core-api:8000 — set by docker-compose.face-core.yml
# Host dev / curl from laptop: http://localhost:8081
FACE_CORE_URL=http://host.docker.internal:8081
FACE_CORE_API_KEY=
FACE_CORE_TIMEOUT_SECONDS=120

# JWT is required on face HTTP routes and the kiosk WebSocket session.
FACE_ROUTES_REQUIRE_JWT=true

# Storage Backend ("local" or "s3" for AWS S3 / MinIO / Cloudflare R2)
STORAGE_BACKEND=local
IMAGE_RETENTION_DAYS=90
TEMP_RETENTION_HOURS=24
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=dpu-attendance
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_EXPIRES_SECONDS=3600

# Optional notification channels & HMAC-SHA256 Signed Payroll Webhooks. Empty SMTP_HOST skips email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LINE_CHANNEL_ACCESS_TOKEN=
WEBHOOK_SIGNING_SECRET=
