{
  "name": "sentinelvision-web-manage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postcss": "sass ./src/assets/scss/style.scss ./src/assets/css/style.css && postcss ./src/assets/css/style.css -o ./src/assets/css/style.css",
    "sass": "sass ./src/assets/scss:./src/assets/css/",
    "sass-min": "sass ./src/assets/scss:./src/assets/css/ --style compressed",
    "test:ci": "ng test --configuration ci",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/kiosk-session.spec.ts",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
    "build:prod": "ng build --configuration production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.35",
