# BFF image: CPU API plus the Face Core Python SDK baked in (no sibling volume mount).
# Build with an extra context named face_sdk (see docker-compose.face-core.yml).
# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FACE_DEVICE=cpu \
    PYTHONPATH=/opt/face-core-sdk

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.cpu.txt .
RUN pip install --upgrade pip setuptools wheel && pip install -r requirements.cpu.txt

COPY --from=face_sdk . /opt/face-core-sdk
COPY . .

RUN mkdir -p enrolled_images uploaded_images temp_images

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
