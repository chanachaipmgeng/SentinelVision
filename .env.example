# Copy to .env and adjust as needed:
#   cp .env.example .env

POSTGRES_USER=dpu
POSTGRES_PASSWORD=dpu_secret
POSTGRES_DB=dpu
POSTGRES_PORT=5432

# Public HTTP entry (nginx gateway)
HTTP_PORT=80

# Cosine distance for InsightFace (lower = stricter). Typical match < 0.40
FACE_RECOGNITION_THRESHOLD=0.40

IMAGE_BLUR_THRESHOLD=100.0
IMAGE_BRIGHTNESS_MIN=50
IMAGE_BRIGHTNESS_MAX=200

SECRET_KEY=change-me-in-production
