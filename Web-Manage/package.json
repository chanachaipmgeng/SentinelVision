    "@types/leaflet": "^1.9.8",
    "angularx-flatpickr": "^7.3.0",
    "autoprefixer": "^10.4.17",
    "date-fns": "^3.3.1",
    "echarts": "^5.4.3",
    "flatpickr": "^4.6.13",
    "font-awesome": "^4.7.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "ng2-file-upload": "^9.0.0",
