# Local non-Docker API (optional). Docker Compose injects env instead.
# Builtin dpu-db:
DATABASE_URL=postgresql+asyncpg://dpu:dpu_secret@localhost:5432/dpu
# Shared ../dev-postgres (schema dpu) — also set DB_SCHEMA=dpu:
# DATABASE_URL=postgresql+asyncpg://localdev:localdev_secret@localhost:54320/localdev
# DB_SCHEMA=dpu
FACE_RECOGNITION_THRESHOLD=0.40
CHECK_IN_DEDUPE_SECONDS=300
SECRET_KEY=change-me-in-production
# Schema is managed by Alembic (`alembic upgrade head`, see docs/RUNBOOK.md). Single-node installs
# may let the API migrate at boot; /ready returns 503 until alembic_version == head.
# MIGRATE_ON_STARTUP=false
# REQUIRE_SCHEMA_HEAD=true
# Kiosk WebSocket hardening (defaults shown; 0 = unlimited for the caps)
# WS_KIOSK_AUTH_TIMEOUT_SECONDS=5
# WS_KIOSK_MAX_CONN_PER_IP=16
# WS_KIOSK_MAX_CONN_PER_COMPANY=64
