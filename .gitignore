Web-Manage/src/assets/config.json

# Face images / punch photos / enrollment uploads (biometric PII — never commit)
API-Fast/temp_images/
API-Fast/enrolled_images/
API-Fast/uploaded_images/
API-Fast/uploads/
API-Fast/dataset/
API-Fast/**/*.jpg
API-Fast/**/*.jpeg
API-Fast/**/*.png
API-Fast/**/*.webp

